---
import Icon from "../Icon.astro";
---

<section class="max-w-[1200px] mx-auto my-12 px-6">
  <div class="py-4 px-8 flex items-center justify-between gap-6 flex-wrap rounded-2xl bg-[#0c121e]/80 backdrop-blur-md border border-[rgba(137,190,255,0.14)] shadow-[0_10px_30px_rgba(0,0,0,0.3)]">
    <span class="text-[#8ea0b5] font-outfit font-bold text-[11px] tracking-[0.15em] uppercase">TUDO O QUE VOCÊ PRECISA PARA</span>
    <div class="flex items-center gap-8 flex-wrap text-[#cbd5e1] text-[13px] font-medium">
      <div class="flex items-center gap-2"><span class="text-[#00d9ff]"><Icon name="sparkles" /></span> Motor de SEO com IA</div>
      <div class="flex items-center gap-2"><span class="text-[#00d9ff]"><Icon name="search" /></span> Inteligência de Palavras-chave</div>
      <div class="flex items-center gap-2"><span class="text-[#00d9ff]"><Icon name="wand-sparkles" /></span> Otimização de Título</div>
      <div class="flex items-center gap-2"><span class="text-[#3df2a4]"><Icon name="check" /></span> Gerador de Tags do YouTube</div>
    </div>
  </div>
</section>
