---
import Icon from "../Icon.astro";

const secFull = (bg: string) => `py-[100px] px-[6vw] max-w-none ${bg} max-[900px]:py-[70px] max-[620px]:py-[50px]`;
const h2 = "font-outfit font-extrabold text-[clamp(32px,3.8vw,52px)] leading-[1.08] tracking-[-0.04em] mt-3 mb-4 [&_span]:text-[#2c8cff]";
const eyebrow = "text-red font-outfit font-semibold text-[11px] tracking-[0.16em] uppercase inline-flex items-center";
const dot = "inline-block w-[6px] h-[6px] bg-red rounded-full mr-[9px] shadow-[0_0_10px_#1688ff]";
const introP = "max-w-[480px] text-muted text-[15px] leading-[1.7]";

const faqs = [
  ["Was ist VidRank?", "VidRank ist eine KI-gestützte YouTube-Optimierungs-Engine, die Creators hilft, automatisch leistungsstarke Titel, Beschreibungen, Keywords und Tags zu generieren."],
  ["Hat VidRank eine Chrome-Erweiterung?", "Ja. VidRank hat eine kostenlose Chrome-Erweiterung, die optimierte YouTube-Titel, Beschreibungen und Tags mit einem Klick generiert. Installiere sie im Chrome Web Store."],
  ["Wie generiert VidRank mein SEO?", "VidRank generiert alles direkt aus deinem Videotitel oder dem umbenannten Videodateinamen. Benenne einfach deine Videodatei um (z. B. basketball_zeitlupe.mp4) oder gib deinen Titel ein — unsere KI extrahiert automatisch Nische, Suchintention und Keywords."],
  ["Generiert VidRank YouTube-Tags?", "Ja. VidRank generiert relevante Tags und Keyword-Varianten, die du überprüfen und direkt in deinen Upload-Prozess kopieren kannst."],
  ["Kann ich VidRank kostenlos nutzen?", "Ja. Der Free-Plan umfasst 10 Generierungen pro Tag und die wichtigsten SEO-Optimierungstools."],
  ["Ist VidRank auch für kleine YouTube-Kanäle nützlich?", "Auf jeden Fall. VidRank gibt jedem Creator einen klareren Ausgangspunkt — egal, ob du dein erstes Video veröffentlichst oder einen wachsenden Katalog aufbaust."],
  ["Garantiert VidRank mehr Aufrufe?", "VidRank verbessert die SEO- und Auffindbarkeits-Signale deines Videos, aber kein Tool kann eine bestimmte Anzahl an Aufrufen oder Rankings garantieren."],
];

// FAQPage structured data — parsed by AI answer engines (ChatGPT, Perplexity, Google AI Overviews)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([question, answer]) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---

<section class={`${secFull("bg-[#0a0e16]")} grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-12 lg:gap-16 max-w-[1440px] mx-auto`}>
  <div class="section-intro" data-reveal>
    <span class={eyebrow}><i class={dot}></i>ÜBER VIDRANK</span>
    <h2 class={h2}>Häufig gestellte <span>Fragen.</span></h2>
    <p class={introP}>Alles, was du wissen musst, um zu entscheiden, ob VidRank zu deinem Workflow passt.</p>
  </div>
  <div class="border-t border-line" data-reveal>
    {faqs.map(([q, a], i) => (
      <div class={`faq-item border-b border-line [&>p]:hidden [&.open>p]:block [&.open_.chev]:rotate-180 [&.open_.chev]:text-cyan ${i === 0 ? "open" : ""}`}>
        <h3 class="my-0">
          <button class="w-full flex justify-between items-center py-5 text-white hover:text-cyan transition-colors border-0 bg-transparent text-left font-outfit font-semibold text-[17px] cursor-pointer">
            {q}
            <span class="chev text-[#94a3b8] transition-transform duration-200"><Icon name="chevron-down" /></span>
          </button>
        </h3>
        <p class="max-w-[650px] -mt-1 mb-5 text-[#cbd5e1] text-[14px] leading-[1.7]">{a}</p>
      </div>
    ))}
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<script>
  document.querySelectorAll(".faq-item button").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".faq-item");
      if (!item) return;
      const isOpen = item.classList.contains("open");
      document.querySelectorAll(".faq-item").forEach((el) => el.classList.remove("open"));
      if (!isOpen) {
        item.classList.add("open");
      }
    });
  });
</script>
