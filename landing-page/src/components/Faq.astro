---
import Icon from "./Icon.astro";

const secFull = (bg: string) => `py-[100px] px-[6vw] max-w-none ${bg} max-[900px]:py-[70px] max-[620px]:py-[50px]`;
const h2 = "font-outfit font-extrabold text-[clamp(32px,3.8vw,52px)] leading-[1.08] tracking-[-0.04em] mt-3 mb-4 [&_span]:text-[#2c8cff]";
const eyebrow = "text-red font-outfit font-semibold text-[11px] tracking-[0.16em] uppercase inline-flex items-center";
const dot = "inline-block w-[6px] h-[6px] bg-red rounded-full mr-[9px] shadow-[0_0_10px_#1688ff]";
const introP = "max-w-[480px] text-muted text-[15px] leading-[1.7]";

const faqs = [
  ["What is VidRank?", "VidRank is an AI-powered YouTube optimization engine that helps creators generate high-ranking titles, descriptions, keywords, and tags automatically."],
  ["Does VidRank have a Chrome extension?", "Yes. VidRank has a free Chrome extension that generates optimized YouTube titles, descriptions, and tags in one click. Install it from the Chrome Web Store."],
  ["How does VidRank generate my SEO?", "VidRank generates everything directly from your video title or renamed video file name. Simply rename your video file (e.g., basketball_slowmo.mp4) or enter your title — our AI extracts the niche, search intent, and keywords automatically."],
  ["Does VidRank generate YouTube tags?", "Yes. VidRank generates relevant tags and keyword variations you can review and copy into your upload flow."],
  ["Can I use VidRank for free?", "Yes. The Free plan includes 10 generations per day and essential SEO optimization tools."],
  ["Is VidRank useful for small YouTube channels?", "Absolutely. VidRank gives every creator a clearer starting point, whether you are publishing your first video or growing a catalog."],
  ["Does VidRank guarantee more views?", "VidRank helps improve your video's SEO and discoverability signals, but no tool can guarantee a specific number of views or rankings."],
];

// FAQPage structured data — parsed by AI answer engines (ChatGPT, Perplexity, Google AI Overviews)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([question, answer]) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---

<section class={`${secFull("bg-[#0a0e16]")} grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-12 lg:gap-16 max-w-[1440px] mx-auto`}>
  <div class="section-intro" data-reveal>
    <span class={eyebrow}><i class={dot}></i>ABOUT VIDRANK</span>
    <h2 class={h2}>Frequently asked <span>questions.</span></h2>
    <p class={introP}>Everything you need to decide if VidRank fits your workflow.</p>
  </div>
  <div class="border-t border-line" data-reveal>
    {faqs.map(([q, a], i) => (
      <div class={`faq-item border-b border-line [&>p]:hidden [&.open>p]:block [&.open_.chev]:rotate-180 [&.open_.chev]:text-cyan ${i === 0 ? "open" : ""}`}>
        <h3 class="my-0">
          <button class="w-full flex justify-between items-center py-5 text-white hover:text-cyan transition-colors border-0 bg-transparent text-left font-outfit font-semibold text-[17px] cursor-pointer">
            {q}
            <span class="chev text-[#94a3b8] transition-transform duration-200"><Icon name="chevron-down" /></span>
          </button>
        </h3>
        <p class="max-w-[650px] -mt-1 mb-5 text-[#cbd5e1] text-[14px] leading-[1.7]">{a}</p>
      </div>
    ))}
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<script>
  document.querySelectorAll(".faq-item button").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".faq-item");
      if (!item) return;
      const isOpen = item.classList.contains("open");
      document.querySelectorAll(".faq-item").forEach((el) => el.classList.remove("open"));
      if (!isOpen) {
        item.classList.add("open");
      }
    });
  });
</script>
