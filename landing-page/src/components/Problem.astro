---
import Icon from "./Icon.astro";

const sec = "py-[110px] px-[8vw] mx-auto max-w-[1440px] max-[900px]:py-[80px] max-[620px]:py-[60px]";
const h2 = "font-outfit font-extrabold text-[clamp(36px,4.5vw,60px)] leading-[1.05] tracking-[-0.04em] mt-3 mb-4 [&_span]:text-[#2c8cff]";
const eyebrow = "text-red font-outfit font-semibold text-[11px] tracking-[0.16em] uppercase inline-flex items-center";
const dot = "inline-block w-[6px] h-[6px] bg-red rounded-full mr-[9px] shadow-[0_0_10px_#1688ff]";
const introP = "max-w-[580px] text-muted text-[16px] leading-[1.7]";

const problemCards = [
  {
    step: "01",
    title: "Finding the right keywords",
    body: "Creators waste hours guessing what people actually search for across YouTube search and suggested feeds.",
    icon: "search",
    accent: "text-cyan",
    border: "hover:border-cyan/50",
  },
  {
    step: "02",
    title: "Writing metadata",
    body: "Titles, descriptions, and tags can take almost as much thought as the video itself, often with uncertain rankings.",
    icon: "file-text",
    accent: "text-red",
    border: "hover:border-red/50",
  },
  {
    step: "03",
    title: "Understanding YouTube SEO",
    body: "Balance search intent, relevance, competition, and discoverability without the guesswork.",
    icon: "chart-column",
    accent: "text-[#3df2a4]",
    border: "hover:border-[#3df2a4]/50",
  },
];
---

<section class={`${sec} flex flex-col items-start`}>
  <!-- Top Headline & Intro spanning full width -->
  <div class="section-intro max-w-[700px] mb-12" data-reveal>
    <span class={eyebrow}><i class={dot}></i>THE CREATOR'S DILEMMA</span>
    <h2 class={h2}>You made the video.<br /><span>Now comes the hard part.</span></h2>
    <p class={introP}>Great content deserves to be found. But the optimization layer can feel like an exhausting second job.</p>
  </div>

  <!-- 3 Spacious Feature Cards in a full-width row -->
  <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-6">
    {problemCards.map(({ step, title, body, icon, accent, border }) => (
      <div class={`rounded-2xl p-8 bg-[#0c121e]/90 backdrop-blur-md border border-[rgba(137,190,255,0.16)] flex flex-col justify-between min-h-[310px] transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_16px_50px_rgba(0,119,255,0.15)] ${border}`} data-reveal>
        <div>
          <span class="font-outfit font-bold text-[14px] text-red block mb-6">{step}</span>
          <h3 class="font-outfit font-bold text-[22px] text-white leading-[1.3] mb-3">{title}</h3>
          <p class="text-[#94a3b8] text-[14px] leading-[1.7]">{body}</p>
        </div>
        <div class="mt-8">
          <div class={`w-9 h-9 rounded-xl bg-white/[0.04] border border-white/[0.08] ${accent} flex items-center justify-center`}>
            <Icon name={icon as any} />
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Bottom Callout Banner spanning full width -->
  <div class="w-full mt-10 p-6 rounded-2xl bg-[linear-gradient(135deg,rgba(0,119,255,0.1),rgba(0,240,255,0.03))] border border-[rgba(0,119,255,0.28)] flex items-center justify-between gap-4 flex-wrap" data-reveal>
    <div class="flex items-center gap-3.5">
      <div class="w-8 h-8 rounded-full bg-cyan/15 border border-cyan/30 text-cyan flex items-center justify-center shrink-0">
        <Icon name="circle-check" />
      </div>
      <strong class="font-outfit font-bold text-[16px] text-white">VidRank handles the optimization layer for you.</strong>
    </div>
    <span class="text-[#94a3b8] text-[14px]">Spend less time second-guessing. Publish with direction.</span>
  </div>
</section>
