---
import Icon from "./Icon.astro";
import LangSwitcher from "./LangSwitcher.astro";

const btn =
  "inline-flex items-center justify-center gap-[9px] min-h-[42px] px-5 font-bold text-[13px] text-white rounded-lg transition-[transform,box-shadow,background-color] duration-200 hover:-translate-y-[2px]";
const btnPrimary = `${btn} bg-[#0066ee] hover:bg-[#0055cc] shadow-[0_4px_20px_rgba(0,102,238,.4)] hover:shadow-[0_6px_25px_rgba(0,102,238,.6)]`;
---

<header
  class="h-19.5 sticky top-0 z-40 flex items-center justify-between px-[5vw] bg-[rgba(10,13,20,.8)] backdrop-blur-[20px] border-b border-line"
>
  <a
    href="/"
    class="inline-flex items-center gap-2.5 font-outfit font-extrabold text-[17px] tracking-[0.12em] text-white no-underline"
  >
    <img
      src="/logo.svg"
      alt="VidRank logo"
      width="27"
      height="27"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="w-[27px] h-[27px] object-contain rounded-md"
    />
    VIDRANK
  </a>

  <nav class="flex gap-8 text-[#8b99ad] text-[13px] max-[900px]:hidden">
    <a href="/#showcase" class="hover:text-white transition-colors no-underline"
      >Product</a
    >
    <a href="/#how" class="hover:text-white transition-colors no-underline"
      >How it works</a
    >
    <a href="/#features" class="hover:text-white transition-colors no-underline"
      >Features</a
    >
    <a href="/#pricing" class="hover:text-white transition-colors no-underline"
      >Pricing</a
    >
    <a href="/blog" class="hover:text-white transition-colors no-underline"
      >Blog</a
    >
  </nav>

  <!-- Desktop Actions Area -->
  <div class="flex items-center gap-4 max-[620px]:hidden">
    <LangSwitcher />
    <!-- Logged-out state button -->
    <button
      id="navLoginBtn"
      type="button"
      class="bg-white/[0.04] border border-white/[0.12] hover:bg-white/[0.08] hover:border-white/20 text-[#cbd5e1] hover:text-white text-[13px] font-medium py-2 px-3.5 rounded-lg transition-all cursor-pointer flex items-center gap-2"
    >
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
        <path
          fill="#4285F4"
          d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
        ></path>
        <path
          fill="#34A853"
          d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
        ></path>
        <path
          fill="#FBBC05"
          d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
        ></path>
        <path
          fill="#EA4335"
          d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
        ></path>
      </svg>
      <span id="navLoginBtnText">Log in</span>
    </button>

    <!-- Logged-in profile badge & dropdown container -->
    <div id="navUserContainer" class="relative hidden">
      <button
        id="navUserMenuBtn"
        type="button"
        class="flex items-center gap-2.5 p-1.5 pr-3 rounded-full bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 hover:border-white/20 transition-all cursor-pointer text-left"
        aria-expanded="false"
      >
        <div
          id="navUserAvatar"
          class="w-7 h-7 rounded-full bg-[#0066ee]/20 text-[#2c8cff] font-bold text-[11px] grid place-items-center overflow-hidden shrink-0 border border-white/15"
        >
          V
        </div>
        <div class="flex flex-col">
          <span
            id="navUserName"
            class="text-white text-[12px] font-semibold max-w-[95px] truncate leading-tight"
          >
            Creator
          </span>
        </div>
        <span
          id="navUserTierBadge"
          class="text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-white/10 text-[#8ea0b5] border border-white/10 ml-0.5"
        >
          FREE
        </span>
        <Icon name="chevron-down" />
      </button>

      <!-- Dropdown Card -->
      <div
        id="navUserDropdown"
        class="hidden absolute right-0 top-[calc(100%+8px)] w-64 p-4 rounded-xl bg-[#0c121e] border border-[rgba(255,255,255,0.12)] shadow-[0_20px_50px_rgba(0,0,0,0.7)] backdrop-blur-xl z-50 text-left"
      >
        <div class="flex items-center gap-3 pb-3 border-b border-white/10">
          <div
            id="navUserDropdownAvatar"
            class="w-10 h-10 rounded-full bg-[#0066ee]/20 text-[#2c8cff] font-bold text-sm grid place-items-center overflow-hidden shrink-0 border border-white/20"
          >
            V
          </div>
          <div class="overflow-hidden">
            <div
              id="navUserDropdownName"
              class="text-white font-outfit font-bold text-[14px] truncate leading-tight"
            >
              Creator
            </div>
            <div
              id="navUserDropdownEmail"
              class="text-[#8ea0b5] text-[11px] truncate leading-tight mt-0.5"
            >
              •••••••••••••
            </div>
          </div>
        </div>

        <div class="py-3 border-b border-white/10 flex flex-col gap-2">
          <div class="flex items-center justify-between text-[11px]">
            <span class="text-[#8ea0b5]">Current Plan</span>
            <span
              id="navDropdownPlan"
              class="font-bold text-[#3df2a4] uppercase text-[10px] px-1.5 py-0.5 rounded bg-[#3df2a4]/10 border border-[#3df2a4]/20"
            >
              FREE
            </span>
          </div>
          <div class="flex items-center justify-between text-[11px]">
            <span class="text-[#8ea0b5]">Daily Quota</span>
            <span
              id="navDropdownQuota"
              class="font-semibold text-white font-mono text-[11px]"
            >
              10 / 10 left
            </span>
          </div>
        </div>

        <div class="pt-3 flex flex-col gap-2">
          <a
            href="/dashboard"
            class="w-full h-9 px-3 text-center rounded-lg bg-white/[0.06] hover:bg-white/10 text-white font-semibold text-[12px] border border-white/10 no-underline transition-colors flex items-center justify-center gap-2"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            Dashboard & Usage
          </a>
          <a
            id="navUpgradeBtn"
            href="/#pricing"
            class="w-full h-9 px-3 text-center rounded-lg bg-[#0066ee] hover:bg-[#0055cc] text-white font-bold text-[12px] no-underline transition-all shadow-[0_4px_15px_rgba(0,102,238,0.4)] flex items-center justify-center gap-2"
          >
            Upgrade to Pro
          </a>
          <button
            id="navLogoutBtn"
            type="button"
            class="w-full py-1.5 px-3 text-center rounded-lg bg-transparent hover:bg-white/[0.06] text-[#ff6b6b] hover:text-[#ff8585] font-medium text-[12px] border-0 cursor-pointer transition-colors"
          >
            Sign out
          </button>
        </div>
      </div>
    </div>

    <!-- Chrome Web Store Action Button -->
    <a
      href="https://chromewebstore.google.com/detail/vidrank/meafpgipnldknnbnmahbmbaakcmahogk"
      target="_blank"
      rel="noopener noreferrer"
      class={`${btnPrimary} no-underline flex items-center gap-2`}
    >
      <img
        src="/chrome-store-logo.svg"
        alt="Chrome Store"
        width="16"
        height="16"
        loading="eager"
        decoding="async"
        class="w-4 h-4 object-contain"
      />
      <span>Add to Chrome</span>
    </a>
  </div>

  <!-- Mobile Hamburger Button -->
  <button
    id="menuBtn"
    class="bg-transparent border-0 text-[#8b99ad] hover:text-white hidden max-[900px]:block cursor-pointer p-1 transition-colors"
    aria-label="Open Menu"
  >
    <Icon name="menu" />
  </button>
</header>

<!-- Mobile Drawer Backdrop -->
<div
  id="mobileBackdrop"
  class="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 transition-opacity duration-300 opacity-0 pointer-events-none [&.open]:opacity-100 [&.open]:pointer-events-auto"
>
</div>

<!-- Mobile Sidepanel Drawer -->
<aside
  id="mobileNav"
  class="fixed top-0 right-0 bottom-0 w-[85vw] max-w-[340px] bg-[#0c121e] border-l border-white/10 shadow-[0_0_60px_rgba(0,0,0,0.9)] z-50 flex flex-col justify-between p-6 transition-transform duration-300 ease-out translate-x-full [&.open]:translate-x-0 overflow-y-auto"
>
  <div>
    <!-- Sidepanel Header -->
    <div
      class="flex items-center justify-between pb-5 border-b border-white/10 mb-6"
    >
      <a
        href="/"
        class="inline-flex items-center gap-[10px] font-outfit font-extrabold text-[16px] tracking-[0.12em] text-white no-underline"
      >
        <img
          src="/logo.svg"
          alt="VidRank logo"
          width="24"
          height="24"
          loading="lazy"
          decoding="async"
          class="w-6 h-6 object-contain rounded-md"
        />
        VIDRANK
      </a>
      <button
        id="closeMobileNav"
        type="button"
        class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 text-[#8b99ad] hover:text-white flex items-center justify-center cursor-pointer transition-colors"
        aria-label="Close menu"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Navigation Links -->
    <nav class="flex flex-col gap-1.5 mobile-nav-links">
      <a
        href="/#showcase"
        class="flex items-center justify-between py-3 px-3.5 rounded-xl text-[#cbd5e1] hover:text-white hover:bg-white/5 text-[14px] font-medium no-underline transition-all"
      >
        <span>Product</span>
        <span class="text-[#8ea0b5]/50 text-xs">→</span>
      </a>
      <a
        href="/#how"
        class="flex items-center justify-between py-3 px-3.5 rounded-xl text-[#cbd5e1] hover:text-white hover:bg-white/5 text-[14px] font-medium no-underline transition-all"
      >
        <span>How it works</span>
        <span class="text-[#8ea0b5]/50 text-xs">→</span>
      </a>
      <a
        href="/#features"
        class="flex items-center justify-between py-3 px-3.5 rounded-xl text-[#cbd5e1] hover:text-white hover:bg-white/5 text-[14px] font-medium no-underline transition-all"
      >
        <span>Features</span>
        <span class="text-[#8ea0b5]/50 text-xs">→</span>
      </a>
      <a
        href="/#pricing"
        class="flex items-center justify-between py-3 px-3.5 rounded-xl text-[#cbd5e1] hover:text-white hover:bg-white/5 text-[14px] font-medium no-underline transition-all"
      >
        <span>Pricing</span>
        <span class="text-[#8ea0b5]/50 text-xs">→</span>
      </a>
      <a
        href="/blog"
        class="flex items-center justify-between py-3 px-3.5 rounded-xl text-[#cbd5e1] hover:text-white hover:bg-white/5 text-[14px] font-medium no-underline transition-all"
      >
        <span>Blog</span>
        <span class="text-[#8ea0b5]/50 text-xs">→</span>
      </a>
    </nav>
  </div>

  <!-- Sidepanel Footer Area -->
  <div class="flex flex-col gap-3.5 pt-6 border-t border-white/10 mt-6">
    <!-- Mobile Logged-out button -->
    <div id="mobileAuthOut">
      <button
        id="mobileLoginBtn"
        type="button"
        class="w-full py-3 px-4 rounded-xl bg-white/[0.06] hover:bg-white/[0.1] border border-white/15 text-white font-semibold text-[13px] flex items-center justify-center gap-2.5 cursor-pointer transition-all"
      >
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
          <path
            fill="#4285F4"
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
          ></path>
          <path
            fill="#34A853"
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
          ></path>
          <path
            fill="#FBBC05"
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
          ></path>
          <path
            fill="#EA4335"
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
          ></path>
        </svg>
        <span id="mobileLoginBtnText">Sign in with Google</span>
      </button>
    </div>

    <!-- Mobile Logged-in profile card -->
    <div
      id="mobileAuthIn"
      class="hidden flex flex-col gap-3 p-3.5 rounded-xl bg-white/[0.04] border border-white/10"
    >
      <div class="flex items-center gap-3">
        <div
          id="mobileUserAvatar"
          class="w-10 h-10 rounded-full bg-[#0066ee]/20 text-[#2c8cff] font-bold text-xs grid place-items-center overflow-hidden shrink-0 border border-white/20"
        >
          V
        </div>
        <div class="overflow-hidden flex-1">
          <div
            id="mobileUserName"
            class="text-white font-bold text-[14px] truncate"
          >
            Creator
          </div>
          <div id="mobileUserEmail" class="text-[#8ea0b5] text-[11px] truncate">
            •••••••••••••
          </div>
        </div>
        <span
          id="mobileUserBadge"
          class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-white/10 text-[#8ea0b5] border border-white/10"
        >
          FREE
        </span>
      </div>

      <div
        class="flex items-center justify-between text-[11px] text-[#cbd5e1] pt-1 border-t border-white/5"
      >
        <span>Daily Quota</span>
        <span
          id="mobileUserQuota"
          class="font-semibold text-[#3df2a4] font-mono">10 / 10 left</span
        >
      </div>

      <button
        id="mobileLogoutBtn"
        type="button"
        class="w-full py-2 px-3 rounded-lg bg-white/[0.06] hover:bg-white/10 text-[#ff6b6b] hover:text-[#ff8585] font-medium text-[12px] border-0 cursor-pointer transition-colors"
      >
        Sign out
      </button>
    </div>

    <a
      id="mobileUpgradeBtn"
      href="/#pricing"
      class={`${btnPrimary} w-full text-center flex items-center justify-center gap-2 no-underline`}
    >
      <Icon name="sparkles" />
      <span id="mobileUpgradeBtnText">Upgrade to Pro</span>
    </a>

    <div class="flex justify-center">
      <LangSwitcher />
    </div>
  </div>
</aside>

<script>
  import {
    loginWithGoogle,
    logout,
    initAuthListener,
    getCachedUser,
    type VidRankUser,
  } from "../lib/firebase";

  // Elements
  const navLoginBtn = document.getElementById(
    "navLoginBtn",
  ) as HTMLButtonElement | null;
  const navLoginBtnText = document.getElementById("navLoginBtnText");
  const navUserContainer = document.getElementById("navUserContainer");
  const navUserMenuBtn = document.getElementById("navUserMenuBtn");
  const navUserDropdown = document.getElementById("navUserDropdown");
  const navUserAvatar = document.getElementById("navUserAvatar");
  const navUserName = document.getElementById("navUserName");
  const navUserTierBadge = document.getElementById("navUserTierBadge");
  const navUserDropdownAvatar = document.getElementById(
    "navUserDropdownAvatar",
  );
  const navUserDropdownName = document.getElementById("navUserDropdownName");
  const navUserDropdownEmail = document.getElementById("navUserDropdownEmail");
  const navDropdownPlan = document.getElementById("navDropdownPlan");
  const navDropdownQuota = document.getElementById("navDropdownQuota");
  const navUpgradeBtn = document.getElementById("navUpgradeBtn");
  const navLogoutBtn = document.getElementById("navLogoutBtn");

  // Mobile elements
  const menuBtn = document.getElementById("menuBtn");
  const closeMobileNav = document.getElementById("closeMobileNav");
  const mobileBackdrop = document.getElementById("mobileBackdrop");
  const mobileNav = document.getElementById("mobileNav");
  const mobileAuthOut = document.getElementById("mobileAuthOut");
  const mobileLoginBtn = document.getElementById(
    "mobileLoginBtn",
  ) as HTMLButtonElement | null;
  const mobileLoginBtnText = document.getElementById("mobileLoginBtnText");
  const mobileAuthIn = document.getElementById("mobileAuthIn");
  const mobileUserAvatar = document.getElementById("mobileUserAvatar");
  const mobileUserName = document.getElementById("mobileUserName");
  const mobileUserEmail = document.getElementById("mobileUserEmail");
  const mobileUserBadge = document.getElementById("mobileUserBadge");
  const mobileUserQuota = document.getElementById("mobileUserQuota");
  const mobileLogoutBtn = document.getElementById("mobileLogoutBtn");
  const mobileUpgradeBtn = document.getElementById(
    "mobileUpgradeBtn",
  ) as HTMLAnchorElement | null;
  const mobileUpgradeBtnText = document.getElementById("mobileUpgradeBtnText");

  // Sidepanel Toggle Logic
  function openSidepanel() {
    mobileBackdrop?.classList.add("open");
    mobileNav?.classList.add("open");
    document.body.classList.add("overflow-hidden");
  }

  function closeSidepanel() {
    mobileBackdrop?.classList.remove("open");
    mobileNav?.classList.remove("open");
    document.body.classList.remove("overflow-hidden");
  }

  menuBtn?.addEventListener("click", openSidepanel);
  closeMobileNav?.addEventListener("click", closeSidepanel);
  mobileBackdrop?.addEventListener("click", closeSidepanel);
  mobileUpgradeBtn?.addEventListener("click", closeSidepanel);

  // Close sidepanel when clicking any nav link
  document.querySelectorAll(".mobile-nav-links a").forEach((link) => {
    link.addEventListener("click", closeSidepanel);
  });

  function renderAvatar(
    container: HTMLElement | null,
    photoUrl: string | undefined,
    name: string | undefined,
  ) {
    if (!container) return;
    if (photoUrl) {
      container.innerHTML = `<img src="${photoUrl}" alt="${name || "User"}" class="w-full h-full object-cover" referrerpolicy="no-referrer" />`;
    } else {
      const initial = (name || "V").trim().charAt(0).toUpperCase();
      container.textContent = initial;
    }
  }

  const navBillingBtn = document.getElementById(
    "navBillingBtn",
  ) as HTMLButtonElement | null;

  function updateNavbarUI(user: VidRankUser | null) {
    if (user) {
      const isPro = user.tier === "pro";
      const displayName = user.name || user.email?.split("@")[0] || "User";
      const quotaRemaining =
        user.quota?.remaining != null ? user.quota.remaining : 10;
      const quotaLimit = user.quota?.limit != null ? user.quota.limit : 10;
      const quotaText = isPro
        ? "Unlimited"
        : `${quotaRemaining} / ${quotaLimit} left`;

      // Desktop
      if (navLoginBtn) navLoginBtn.classList.add("hidden");
      if (navUserContainer) navUserContainer.classList.remove("hidden");

      renderAvatar(navUserAvatar, user.photo_url, displayName);
      renderAvatar(navUserDropdownAvatar, user.photo_url, displayName);

      if (navUserName) navUserName.textContent = displayName;
      if (navUserDropdownName) navUserDropdownName.textContent = displayName;
      if (navUserDropdownEmail)
        navUserDropdownEmail.textContent = user.email || "";

      if (navUserTierBadge) {
        navUserTierBadge.textContent = isPro ? "PRO" : "FREE";
        navUserTierBadge.className = isPro
          ? "text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-[#3df2a4]/15 text-[#3df2a4] border border-[#3df2a4]/30 ml-0.5 shadow-[0_0_10px_rgba(61,242,164,0.2)]"
          : "text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-white/10 text-[#8ea0b5] border border-white/10 ml-0.5";
      }

      if (navDropdownPlan) {
        navDropdownPlan.textContent = isPro ? "PRO" : "FREE";
        navDropdownPlan.className = isPro
          ? "font-bold text-[#3df2a4] uppercase text-[10px] px-1.5 py-0.5 rounded bg-[#3df2a4]/10 border border-[#3df2a4]/20"
          : "font-bold text-[#8ea0b5] uppercase text-[10px] px-1.5 py-0.5 rounded bg-white/10 border border-white/10";
      }

      if (navDropdownQuota) {
        navDropdownQuota.textContent = quotaText;
        navDropdownQuota.className = isPro
          ? "font-bold text-[#3df2a4] font-mono text-[11px]"
          : "font-semibold text-white font-mono text-[11px]";
      }

      if (navUpgradeBtn) {
        if (isPro) {
          navUpgradeBtn.innerHTML = `
            <span class="w-2 h-2 rounded-full bg-[#3df2a4] shadow-[0_0_6px_#3df2a4]"></span>
            Pro Member
          `;
          navUpgradeBtn.className =
            "w-full h-9 px-3 text-center rounded-lg bg-[#3df2a4]/10 text-[#3df2a4] font-bold text-[12px] border border-[#3df2a4]/25 flex items-center justify-center gap-2 pointer-events-none no-underline shadow-[0_0_12px_rgba(61,242,164,0.15)]";
        } else {
          navUpgradeBtn.innerHTML = "Upgrade to Pro";
          navUpgradeBtn.className =
            "w-full h-9 px-3 text-center rounded-lg bg-[#0066ee] hover:bg-[#0055cc] text-white font-bold text-[12px] no-underline transition-all shadow-[0_4px_15px_rgba(0,102,238,0.4)] flex items-center justify-center gap-2";
        }
      }

      // Mobile
      if (mobileAuthOut) mobileAuthOut.classList.add("hidden");
      if (mobileAuthIn) mobileAuthIn.classList.remove("hidden");

      renderAvatar(mobileUserAvatar, user.photo_url, displayName);
      if (mobileUserName) mobileUserName.textContent = displayName;
      if (mobileUserEmail) mobileUserEmail.textContent = user.email || "";
      if (mobileUserBadge) {
        mobileUserBadge.textContent = isPro ? "PRO" : "FREE";
        mobileUserBadge.className = isPro
          ? "text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-[#3df2a4]/15 text-[#3df2a4] border border-[#3df2a4]/30"
          : "text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-white/10 text-[#8ea0b5] border border-white/10";
      }
      if (mobileUserQuota) {
        mobileUserQuota.textContent = quotaText;
      }

      if (mobileUpgradeBtn && mobileUpgradeBtnText) {
        if (isPro) {
          mobileUpgradeBtnText.textContent = "Pro Member (Active)";
          mobileUpgradeBtn.classList.add("pointer-events-none", "opacity-75");
        } else {
          mobileUpgradeBtnText.textContent = "Upgrade to Pro";
          mobileUpgradeBtn.classList.remove(
            "pointer-events-none",
            "opacity-75",
          );
        }
      }
    } else {
      // Desktop Logged Out
      if (navLoginBtn) {
        navLoginBtn.classList.remove("hidden");
        navLoginBtn.disabled = false;
      }
      if (navLoginBtnText) navLoginBtnText.textContent = "Log in";
      if (navUserContainer) navUserContainer.classList.add("hidden");
      if (navUserDropdown) navUserDropdown.classList.add("hidden");
      if (navBillingBtn) navBillingBtn.classList.add("hidden");

      // Mobile Logged Out
      if (mobileAuthOut) {
        mobileAuthOut.classList.remove("hidden");
        if (mobileLoginBtn) mobileLoginBtn.disabled = false;
      }
      if (mobileLoginBtnText)
        mobileLoginBtnText.textContent = "Sign in with Google";
      if (mobileAuthIn) mobileAuthIn.classList.add("hidden");

      if (mobileUpgradeBtn && mobileUpgradeBtnText) {
        mobileUpgradeBtnText.textContent = "Upgrade to Pro";
        mobileUpgradeBtn.classList.remove("pointer-events-none", "opacity-75");
      }
    }
  }

  // Fast initial render from cached session
  const cached = getCachedUser();
  if (cached) {
    updateNavbarUI(cached);
  }

  // Handle Login Click
  async function handleLogin() {
    try {
      if (navLoginBtn) navLoginBtn.disabled = true;
      if (navLoginBtnText) navLoginBtnText.textContent = "Signing in...";
      if (mobileLoginBtn) mobileLoginBtn.disabled = true;
      if (mobileLoginBtnText) mobileLoginBtnText.textContent = "Signing in...";

      await loginWithGoogle();
    } catch (err: any) {
      console.error("Login failed:", err);
      if (navLoginBtn) navLoginBtn.disabled = false;
      if (navLoginBtnText) navLoginBtnText.textContent = "Log in";
      if (mobileLoginBtn) mobileLoginBtn.disabled = false;
      if (mobileLoginBtnText)
        mobileLoginBtnText.textContent = "Sign in with Google";
    }
  }

  // Handle Logout Click
  async function handleLogout() {
    try {
      if (navUserDropdown) navUserDropdown.classList.add("hidden");
      await logout();
    } catch (err) {
      console.error("Logout failed:", err);
    }
  }

  // Handle Customer Portal Click
  navBillingBtn?.addEventListener("click", async () => {
    const user = getCachedUser();
    if (!user) return;
    try {
      navBillingBtn.disabled = true;
      navBillingBtn.textContent = "Opening Portal...";

      const { getFirebaseAuthToken } = await import("../lib/firebase");
      const idToken = await getFirebaseAuthToken();
      if (!idToken) throw new Error("Please log in again.");

      const backendUrl = "https://vidrank-backend.fahad288ali.workers.dev";
      const resp = await fetch(`${backendUrl}/v1/billing/customer-portal`, {
        method: "POST",
        headers: {
          Authorization: `Bearer ${idToken}`,
          "Content-Type": "application/json",
        },
      });
      const data = await resp.json();
      if (!resp.ok || !data.url) {
        throw new Error(
          data.message || data.error || "Could not open portal session",
        );
      }
      window.open(data.url, "_blank");
    } catch (err: any) {
      console.error("Customer Portal error:", err);
      alert(
        err.message || "Failed to open billing portal. Please contact support.",
      );
    } finally {
      navBillingBtn.disabled = false;
      navBillingBtn.textContent = "Manage Billing in Paddle";
    }
  });

  navLoginBtn?.addEventListener("click", handleLogin);
  mobileLoginBtn?.addEventListener("click", handleLogin);
  navLogoutBtn?.addEventListener("click", handleLogout);
  mobileLogoutBtn?.addEventListener("click", handleLogout);

  // Toggle Dropdown Menu
  navUserMenuBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    navUserDropdown?.classList.toggle("hidden");
  });

  // Close dropdown on click outside
  document.addEventListener("click", (e) => {
    if (navUserContainer && !navUserContainer.contains(e.target as Node)) {
      navUserDropdown?.classList.add("hidden");
    }
  });

  // Initialize Firebase Auth subscription
  initAuthListener((user) => {
    updateNavbarUI(user);
  });
</script>
