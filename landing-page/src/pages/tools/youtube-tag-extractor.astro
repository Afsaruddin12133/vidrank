---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";

const title = "YouTube Tag Extractor & Checker — Free, Any Video";
const description = "Free YouTube tag extractor and checker: paste any video URL to see its tags ranked, one-click copy, no login. See what top videos in your niche tag.";

const faqs = [
  {
    q: "What does the YouTube Tag Extractor do?",
    a: "You paste any YouTube video URL and the tool shows the exact tags that video uses, in the order its creator added them. Tags are a minor but real ranking signal for misspellings, synonyms, and disambiguation — this tool shows how top videos in your niche cover those variants.",
  },
  {
    q: "How do I see YouTube tags on Chrome?",
    a: "YouTube hides tags from the visible page, so you need a tool: this free extractor works in any browser, or install the VidRank Chrome extension to see tags and generate ranked metadata inline while you browse YouTube.",
  },
  {
    q: "Is this YouTube tag checker free?",
    a: "Yes, completely free with no login — it works as a tag extractor, tag checker, and tags analyzer for any public video. VidRank's free tier also includes AI-generated titles, tags, and descriptions for your own videos.",
  },
  {
    q: "How do I use extracted tags correctly?",
    a: "Keep 15–30 tags per video: your exact topic first, close variants next, then common misspellings and one or two broad category tags. Do not paste 40 near-duplicates — YouTube's guidance warns against it. Use extracted tags to spot gaps in your own set, not to copy wholesale.",
  },
  {
    q: "Why do some videos show no tags?",
    a: "Some creators add no tags, and YouTube strips keywords metadata from certain unavailable or age-restricted videos. If a video shows no tags, it usually means the creator did not add any.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "VidRank YouTube Tag Extractor",
  url: "https://vidrank.tech/tools/youtube-tag-extractor",
  applicationCategory: "SEOApplication",
  operatingSystem: "Any (web)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Layout title={title} description={description}>
  <Navbar />

  <main class="min-h-screen py-12 px-[6vw] max-w-[900px] mx-auto">
    <header class="text-center mb-10">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-[11px] font-bold tracking-wider uppercase border text-emerald-300 bg-emerald-400/10 border-emerald-400/25 mb-6">
        <Icon name="wand-sparkles" /> 100% Free · No Login
      </span>
      <h1 class="font-outfit font-extrabold text-[clamp(30px,4.5vw,48px)] leading-[1.12] tracking-[-0.03em] text-white mb-4">
        YouTube Tag Extractor &amp; Checker
      </h1>
      <p class="text-[#94a3b8] text-[16px] leading-[1.65] max-w-[680px] mx-auto">
        Want to see a video's tags on YouTube? YouTube hides them — this free tool shows them. Paste any YouTube URL to see the exact tags that video uses, ranked in the order its creator added them, one click to copy. Then generate your own ranked set with <a href="/#pricing" class="text-cyan hover:underline">VidRank's AI tag generator</a>.
      </p>
    </header>

    <!-- Tool -->
    <section class="p-6 sm:p-8 rounded-2xl bg-[#0c121e]/90 border border-[rgba(137,190,255,0.16)] shadow-[0_20px_60px_rgba(0,0,0,0.5)] mb-10">
      <form id="extractForm" class="flex flex-col sm:flex-row gap-3">
        <input
          id="videoUrl"
          type="url"
          required
          placeholder="https://www.youtube.com/watch?v=..."
          class="flex-1 min-h-[48px] px-4 rounded-lg bg-[#0a0f18] border border-white/10 text-white text-[14px] placeholder-[#5a6b80] focus:border-cyan focus:outline-none"
          aria-label="YouTube video URL"
        />
        <button
          type="submit"
          id="extractBtn"
          class="min-h-[48px] px-6 font-bold text-[13px] text-white bg-[#0066ee] hover:bg-[#0055cc] rounded-lg shadow-[0_8px_25px_rgba(0,102,238,0.4)] transition-all cursor-pointer whitespace-nowrap"
        >
          Extract Tags
        </button>
      </form>

      <p id="status" class="hidden mt-3 text-[13px]" role="status"></p>

      <div id="results" class="hidden mt-6">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
          <h2 id="videoTitle" class="text-white font-semibold text-[15px]"></h2>
          <button id="copyAllBtn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/[0.05] hover:bg-white/10 text-white text-[12px] border border-white/10 transition-all cursor-pointer">
            <Icon name="check" /> <span id="copyAllText">Copy all tags</span>
          </button>
        </div>
        <ol id="tagList" class="grid grid-cols-1 sm:grid-cols-2 gap-2 list-none p-0 m-0"></ol>
      </div>
    </section>

    <!-- How to use -->
    <section class="mb-10">
      <h2 class="font-outfit font-bold text-[22px] text-white mb-4">How to use extracted tags</h2>
      <ol class="text-[#94a3b8] text-[14px] leading-[1.7] space-y-2 pl-5 list-decimal">
        <li>Paste the URL of a top-ranking video in your niche.</li>
        <li>Copy its tag list and note the variants, synonyms, and misspellings it covers.</li>
        <li>Build your own set of 15–30 tags: exact topic first, variants next, 1–2 broad category tags last.</li>
        <li>Generate a scored, ranked set for your specific video with <a href="/#pricing" class="text-cyan hover:underline">VidRank</a> — it ranks your tags instead of listing them.</li>
      </ol>
    </section>

    <!-- FAQ -->
    <section class="mb-6">
      <h2 class="font-outfit font-bold text-[22px] text-white mb-5">Frequently asked questions</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="group p-5 rounded-xl bg-[#0c121e]/80 border border-white/[0.08]">
            <summary class="cursor-pointer text-white font-semibold text-[14px] list-none flex items-center justify-between gap-4">
              {f.q}
              <span class="text-cyan text-[18px] leading-none group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-3 text-[#94a3b8] text-[13.5px] leading-[1.7]">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />

  <script is:inline>
    const form = document.getElementById("extractForm");
    const input = document.getElementById("videoUrl");
    const btn = document.getElementById("extractBtn");
    const status = document.getElementById("status");
    const results = document.getElementById("results");
    let currentTags = [];

    function setStatus(msg, isError) {
      status.textContent = msg;
      status.className = "mt-3 text-[13px] " + (isError ? "text-red-400" : "text-cyan");
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = "Extracting…";
      setStatus("Fetching tags…", false);
      try {
        const res = await fetch("/api/extract-tags?url=" + encodeURIComponent(input.value));
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Extraction failed");
        currentTags = data.tags || [];
        document.getElementById("videoTitle").textContent = data.title || ("Video " + data.videoId);
        const list = document.getElementById("tagList");
        list.innerHTML = "";
        if (!currentTags.length) {
          setStatus("This video has no tags — the creator did not add any.", true);
        } else {
          results.classList.remove("hidden");
          currentTags.forEach((tag, i) => {
            const li = document.createElement("li");
            li.className = "flex items-center gap-2 py-2 px-3 rounded-lg bg-[#141b27] border border-[rgba(137,190,255,0.14)] text-[13px]";
            li.innerHTML = '<span class="text-[#5a6b80] font-mono text-[11px] w-6 shrink-0">' + (i + 1) + '</span><span class="text-cyan font-mono truncate">' + tag.replace(/</g, "&lt;") + '</span>';
            list.appendChild(li);
          });
          setStatus(currentTags.length + " tags found.", false);
        }
      } catch (err) {
        setStatus(err.message, true);
        results.classList.add("hidden");
      } finally {
        btn.disabled = false;
        btn.textContent = "Extract Tags";
      }
    });

    document.getElementById("copyAllBtn").addEventListener("click", () => {
      navigator.clipboard.writeText(currentTags.join(", ")).then(() => {
        const t = document.getElementById("copyAllText");
        t.textContent = "Copied!";
        setTimeout(() => (t.textContent = "Copy all tags"), 2000);
      });
    });
  </script>
</Layout>
