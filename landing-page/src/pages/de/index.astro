  altPaths={{ en: "/", "pt-BR": "/pt-br/" }}
>
  <Navbar />
  <main id="main-content">
    <Hero />
    <TrustStrip />
    <Problem />
    <HowItWorks />
    <Showcase />
    <ScoreSection />
    <Features />
    <Comparison />
    <Workflow />
    <Pricing />
    <Faq />
    <FinalCta />
