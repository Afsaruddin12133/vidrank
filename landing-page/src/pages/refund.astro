---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const lastUpdated = "August 24, 2026";

const sections = [
  {
    title: "1. 14-Day Money-Back Guarantee",
    content: "We stand behind the quality of VidRank. If you are not completely satisfied with your VidRank Pro subscription, you can request a full refund within 14 days of your initial purchase or subscription upgrade. No complicated questions asked."
  },
  {
    title: "2. How to Request a Refund",
    content: "To request a refund within the 14-day window, simply send an email to support@vidrank.tech with your account email address and Paddle transaction/order number. Our support team processes all eligible refund requests within 1–3 business days."
  },
  {
    title: "3. Subscription Cancellation Process",
    content: "You may cancel your recurring Pro subscription at any time. When you cancel, auto-renewal will be turned off immediately, and you will retain full access to all Pro features until the conclusion of your current billing period. You will not be billed for subsequent cycles."
  },
  {
    title: "4. Billing & Payment Processing",
    content: "All payments and refunds are securely processed by our Merchant of Record, Paddle. Once approved, refunds are credited back to your original payment method (Credit Card, PayPal, Apple Pay, Google Pay) within 5–10 business days depending on your bank's processing times."
  },
  {
    title: "5. Policy Exceptions",
    content: "Refunds requested outside the 14-day initial purchase period are generally not granted except in cases of technical faults or service downtime attributable to VidRank that could not be resolved by our technical team."
  },
  {
    title: "6. Questions & Support",
    content: "If you have any questions regarding your billing, subscriptions, or refund status, please contact our team directly at support@vidrank.tech."
  }
];
---

<Layout
  title="Refund & Cancellation Policy — VidRank"
  description="VidRank's 14-day money-back guarantee, refund request steps, and subscription cancellation policy."
>
  <Navbar />
  <main id="main-content" class="min-h-screen py-16 px-[6vw] max-w-[1440px] mx-auto">
    <div class="max-w-[780px] mx-auto">
      <div class="mb-14" data-reveal>
        <span class="text-red font-outfit font-semibold text-[11px] tracking-[0.16em] uppercase inline-flex items-center">
          <i class="inline-block w-[6px] h-[6px] bg-red rounded-full mr-[9px] shadow-[0_0_10px_#1688ff]"></i>
          LEGAL & BILLING
        </span>
        <h1 class="font-outfit font-extrabold text-[clamp(36px,5vw,56px)] leading-[1.05] tracking-[-0.04em] my-4 text-white">
          Refund & <span class="text-[#2c8cff]">Cancellation Policy.</span>
        </h1>
        <p class="text-muted text-[15px] leading-[1.7]">
          We believe in simple, transparent, creator-first billing.
          Last updated: {lastUpdated}.
        </p>
      </div>

      <div class="flex flex-col gap-10">
        {
          sections.map((s, i) => (
            <section data-reveal>
              <h2 class="font-outfit font-bold text-[20px] text-white leading-[1.3] mb-3" id={`refund-section-${i + 1}`}>
                {s.title}
              </h2>
              <p class="text-[#94a3b8] text-[15px] leading-[1.8]">{s.content}</p>
            </section>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</Layout>
