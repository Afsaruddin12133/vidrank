---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import { getAllPosts, getPostBySlug } from "../../lib/blog";
import { marked } from "marked";

// Configure marked options
marked.setOptions({
  gfm: true,
  breaks: true,
});

const { slug } = Astro.params;
const env = (Astro.locals as any)?.runtime?.env;

// Fetch post dynamically from Cloudflare D1 or fallback
const post = slug ? await getPostBySlug(slug, env) : null;

if (!post) {
  return Astro.redirect("/blog");
}

// Fetch other posts for "Related Guides" section
const allPosts = await getAllPosts(env);
const relatedPosts = allPosts.filter((p) => p.slug !== slug).slice(0, 2);

// Normalize literal escape characters and parse Markdown cleanly
// ponytail: strip leading markdown H1 — hero header already renders the title (fixes duplicate-h1 SEO error)
function renderMarkdown(rawMarkdown: string): string {
  if (!rawMarkdown) return "";
  const normalized = rawMarkdown
    .replace(/\\r\\n/g, "\n")
    .replace(/\\n/g, "\n")
    .replace(/\\t/g, "  ")
    .replace(/^\s*#\s+[^\n]*\n+/, "");
  return marked.parse(normalized) as string;
}

// ponytail: meta title ≤60 chars on word boundary (fixes title-too-long SEO error)
function metaTitle(t: string): string {
  const suffix = " | VidRank";
  const budget = 60 - suffix.length;
  let out = "";
  for (const w of t.split(" ")) {
    if ((out + " " + w).trim().length > budget) break;
    out = (out + " " + w).trim();
  }
  return out.replace(/[\s&:,\-–—]+$/, "") + suffix;
}

const contentHtml = renderMarkdown(post.content_markdown);

// JSON-LD structured data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "description": post.description,
  "author": {
    "@type": "Organization",
    "name": post.author || "VidRank Growth Team",
  },
  "publisher": {
    "@type": "Organization",
    "name": "VidRank",
    "logo": {
      "@type": "ImageObject",
        "url": "https://vidrank.tech/logo.png"
    }
  },
  "datePublished": post.created_at,
  "dateModified": post.updated_at
};
---

<Layout
  title={metaTitle(post.title)}
  description={post.description}
>
  <!-- Sticky Reading Progress Bar -->
  <div id="progressBar" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-cyan via-blue-500 to-[#3df2a4] z-[100] transition-all duration-75 ease-out w-0"></div>

  <Navbar />
  
  <main id="main-content" class="min-h-screen py-10 px-[6vw] max-w-[1200px] mx-auto">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-[12px] text-[#8ea0b5] mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-white transition-colors no-underline">Home</a>
      <span class="text-white/30">/</span>
      <a href="/blog" class="hover:text-white transition-colors no-underline">Blog</a>
      <span class="text-white/30">/</span>
      <span class="text-cyan truncate max-w-[300px] font-medium">{post.category}</span>
    </nav>

    <!-- Post Hero Header -->
    <header class="max-w-[880px] mx-auto text-center mb-14">
      <div class="inline-flex items-center gap-3 mb-6">
        <span class={`px-3.5 py-1 rounded-full text-[11px] font-bold tracking-wider uppercase border shadow-sm ${post.categoryColor || "text-cyan bg-cyan/10 border-cyan/25"}`}>
          {post.category}
        </span>
        <span class="text-[#8ea0b5] text-[12px] font-mono flex items-center gap-1.5 bg-white/[0.04] px-3 py-1 rounded-full border border-white/[0.08]">
          <Icon name="wand-sparkles" /> {post.read_time}
        </span>
      </div>

      <h1 class="font-outfit font-extrabold text-[clamp(32px,4.5vw,54px)] leading-[1.12] tracking-[-0.035em] text-white mb-6">
        {post.title}
      </h1>

      <p class="text-[#94a3b8] text-[17px] leading-[1.65] max-w-[720px] mx-auto mb-8">
        {post.description}
      </p>

      <!-- Author Metadata & Share Bar -->
      <div class="flex items-center justify-between gap-4 py-4 px-6 rounded-2xl bg-[#0c121e]/80 border border-[rgba(137,190,255,0.14)] text-[13px] text-[#8ea0b5] flex-wrap backdrop-blur-md">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-cyan via-blue-600 to-indigo-600 text-white font-bold text-[13px] flex items-center justify-center shadow-[0_0_15px_rgba(0,217,255,0.3)]">
            VR
          </div>
          <div class="text-left">
            <div class="text-white font-semibold">{post.author || "VidRank Growth Team"}</div>
            <div class="text-[11px] text-[#8ea0b5]">
              {new Date(post.created_at).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}
            </div>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button id="copyLinkBtn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/[0.05] hover:bg-white/10 text-white text-[12px] border border-white/10 transition-all cursor-pointer">
            <Icon name="check" /> <span id="copyText">Copy link</span>
          </button>
          <a href="/blog" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[#8ea0b5] hover:text-white hover:bg-white/[0.04] transition-colors text-[12px] no-underline">
            ← All guides
          </a>
        </div>
      </div>
    </header>

    <!-- Main Layout: Content + Sticky Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-12 items-start">
      <!-- Article Body Container -->
      <article class="p-8 sm:p-10 md:p-12 rounded-2xl bg-[#0c121e]/90 border border-[rgba(137,190,255,0.16)] shadow-[0_20px_60px_rgba(0,0,0,0.5)] backdrop-blur-md overflow-hidden">
        <div class="blog-content">
          <div set:html={contentHtml} />
        </div>

        <!-- Tags Cloud at bottom of article -->
        {post.tags && post.tags.length > 0 && (
          <div class="mt-12 pt-8 border-t border-white/[0.08]">
            <span class="block text-[#8ea0b5] font-inter font-semibold text-[11px] tracking-wider uppercase mb-3.5">
              TAGGED TOPICS
            </span>
            <div class="flex flex-wrap gap-2">
              {post.tags.map((tag: string) => (
                <span class="py-1.5 px-3 rounded-lg bg-[#141b27] border border-[rgba(137,190,255,0.16)] text-cyan text-[12px] font-mono">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        )}
      </article>

      <!-- Sticky Sidebar -->
      <aside class="sticky top-24 space-y-6 hidden lg:block">
        <!-- Quick Optimization Box -->
        <div class="p-6 rounded-2xl bg-[linear-gradient(135deg,rgba(0,102,238,0.12),rgba(0,217,255,0.06))] border border-[rgba(0,119,255,0.3)] shadow-lg backdrop-blur-md">
          <div class="flex items-center gap-2 text-cyan font-outfit font-bold text-[14px] uppercase tracking-wider mb-2">
            <Icon name="sparkles" /> VidRank AI Tool
          </div>
          <h3 class="font-outfit font-bold text-[18px] text-white leading-[1.3] mb-2">
            Optimize your video in 1 click
          </h3>
          <p class="text-[#94a3b8] text-[13px] leading-[1.6] mb-5">
            Auto-generate high-CTR titles, descriptions & tags from your video file name.
          </p>
          <a href="/#pricing" class="w-full inline-flex items-center justify-center gap-2 min-h-[42px] px-5 font-bold text-[13px] text-white bg-[#0066ee] hover:bg-[#0055cc] rounded-lg shadow-[0_8px_25px_rgba(0,102,238,0.4)] transition-all no-underline">
            Try VidRank Free <Icon name="arrow-right" />
          </a>
        </div>

        <!-- Related Guides -->
        {relatedPosts.length > 0 && (
          <div class="p-6 rounded-2xl bg-[#0c121e]/80 border border-white/[0.08] backdrop-blur-md">
            <span class="block text-[#8ea0b5] font-inter font-semibold text-[11px] tracking-wider uppercase mb-4">
              RELATED GUIDES
            </span>
            <div class="space-y-4">
              {relatedPosts.map((rel) => (
                <div class="group">
                  <a href={`/blog/${rel.slug}`} class="block text-white group-hover:text-cyan transition-colors text-[14px] font-semibold leading-[1.4] no-underline">
                    {rel.title}
                  </a>
                  <span class="text-[#64748b] text-[11px] mt-1 block">
                    {rel.read_time} • {rel.category}
                  </span>
                </div>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>

    <!-- Bottom Full Width CTA Banner -->
    <div class="mt-16 p-8 sm:p-10 rounded-2xl bg-[linear-gradient(135deg,rgba(0,119,255,0.18),rgba(0,240,255,0.08))] border border-[rgba(0,119,255,0.4)] shadow-[0_20px_60px_rgba(0,0,0,0.6)] flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="font-outfit font-bold text-[24px] text-white mb-2">Ready to rank your YouTube videos higher?</h3>
        <p class="text-[#94a3b8] text-[14px] max-w-[540px]">
          Join thousands of creators using VidRank AI to optimize titles, tags, and keywords in seconds.
        </p>
      </div>
      <a href="/#pricing" class="inline-flex items-center justify-center gap-2 min-h-[46px] px-7 font-bold text-[13px] text-white bg-[#0066ee] hover:bg-[#0055cc] rounded-lg shadow-[0_8px_30px_rgba(0,102,238,0.5)] whitespace-nowrap transition-all no-underline">
        Get Started Free <Icon name="arrow-right" />
      </a>
    </div>
  </main>

  <Footer />

  <!-- Inject Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <script is:inline>
    // Scroll Reading Progress Bar
    window.addEventListener("scroll", () => {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const bar = document.getElementById("progressBar");
      if (bar) bar.style.width = scrolled + "%";
    });

    // Copy Link Button
    const copyBtn = document.getElementById("copyLinkBtn");
    const copyText = document.getElementById("copyText");
    if (copyBtn && copyText) {
      copyBtn.addEventListener("click", () => {
        navigator.clipboard.writeText(window.location.href).then(() => {
          copyText.textContent = "Copied!";
          setTimeout(() => {
            copyText.textContent = "Copy link";
          }, 2000);
        });
      });
    }
  </script>
</Layout>
